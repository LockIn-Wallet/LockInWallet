{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@coral-xyz/anchor": "^0.28.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/wallet-adapter-wallets": "^0.19.32",
    "@solana/web3.js": "^1.78.9",
    "ajv": "^8.17.1",
    "borsh": "^2.0.0",
    "ethers": "^6.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "^5.0.1"
  },
  "scripts": {
    "start": "craco start",
    "start:quiet": "GENERATE_SOURCEMAP=false craco start",
    "start:debug": "REACT_APP_DEBUG=true craco start",
    "start:clean": "npm run clean && npm start",
    "build": "craco build",
    "build:clean": "npm run clean && npm run build",
    "build:production": "NODE_OPTIONS='--max-old-space-size=4096' GENERATE_SOURCEMAP=false DISABLE_ESLINT_PLUGIN=true craco build",
    "build:vercel": "npm run build:production",
    "test": "craco test",
    "test:ci": "craco test --watchAll=false --coverage",
    "test:functionality": "craco test --testPathPattern=functionality --watchAll=false",
    "test:simulation": "craco test --testPathPattern=simulation --watchAll=false",
    "test:e2e": "node -e \"const {QuickSetup} = require('./src/test-utils/TestSetup.js'); QuickSetup.runSpecificTests('functionality|simulation');\"",
    "test:e2e:dev": "node -e \"const {QuickSetup} = require('./src/test-utils/TestSetup.js'); QuickSetup.setupForDevelopment().then(() => console.log('Test environment ready. Run: npm run test:functionality'));\"",
    "test:pipeline": "node -e \"const {QuickSetup} = require('./src/test-utils/TestSetup.js'); QuickSetup.setupForCI();\"",
    "validate:environment": "node -e \"const {validateTestEnvironment} = require('./src/test-utils/TestHelpers.js'); validateTestEnvironment();\"",
    "eject": "react-scripts eject",
    "clean": "rm -rf node_modules/.cache && rm -rf build",
    "env-check": "node -e \"console.log('Node version:', process.version); console.log('Memory limit:', process.env.NODE_OPTIONS); console.log('Port 3000 status:'); require('child_process').exec('lsof -ti:3000', (err, stdout) => console.log(stdout ? 'Port 3000 in use' : 'Port 3000 available'));\"",
    "port-kill": "lsof -ti:3000 | xargs kill -9 2>/dev/null || echo 'No process found on port 3000'",
    "troubleshoot": "npm run env-check && npm run port-kill && npm run clean"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react-native": {
      "react": "18.2.0",
      "react-dom": "18.2.0"
    },
    "@solana/wallet-adapter-react": {
      "react": "18.2.0",
      "react-dom": "18.2.0"
    },
    "@solana/wallet-adapter-react-ui": {
      "react": "18.2.0",
      "react-dom": "18.2.0"
    }
  },
  "resolutions": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "**/react": "18.2.0",
    "**/react-dom": "18.2.0",
    "**/@types/react": "^18.2.0",
    "**/@types/react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "assert": "^2.1.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "node-fetch": "^3.3.2",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5"
  }
}
