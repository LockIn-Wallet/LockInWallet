# Server-only. Never prefixed REACT_APP_ — that prefix is what puts a value
# into the browser bundle, and this one must never go there.
#
# Set it in the Vercel dashboard (Project → Settings → Environment Variables),
# not in a file that could be committed.
#
# Get the key from https://dashboard.pimlico.io. One key covers every chain;
# the proxy picks the right endpoint from the chain in each request.
PIMLICO_API_KEY=

# Also set a sponsorship policy in the Pimlico dashboard. The proxy bounds what
# the money can be spent ON — only calls into our own contracts — but not how
# often, so a daily cap is the other half of that defence and is not optional.
