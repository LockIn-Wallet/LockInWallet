
# Paymaster that pays network fees for users who signed in with a passkey.
# Without it, sign-in still works but a new user cannot afford their first
# transaction — so this is what makes signing in actually usable.
#
# Any ERC-7677 paymaster service URL (Pimlico, Coinbase Paymaster, Alchemy).
# Absent is a supported state: everyone simply pays their own fees, exactly as
# before.
REACT_APP_PAYMASTER_URL=
