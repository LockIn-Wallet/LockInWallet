# Development Environment Configuration
# Copy this file to .env.local and add your private RPC URLs

NODE_ENV=development

# Private RPC Configuration for Development
# Replace with your actual private RPC endpoints
REACT_APP_POLYGON_RPC_PRIVATE=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE
REACT_APP_ETHEREUM_RPC_PRIVATE=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY_HERE

# Optional: Multiple private RPCs for redundancy
REACT_APP_POLYGON_RPC_PRIVATE_2=https://polygon-mainnet.infura.io/v3/YOUR_PROJECT_ID
REACT_APP_POLYGON_RPC_PRIVATE_3=https://rpc.ankr.com/polygon/YOUR_API_KEY

# Debug Configuration
REACT_APP_DEBUG=true

# Feature Flags for Development
REACT_APP_SHOW_LOCALHOST=true
REACT_APP_SHOW_UNDEPLOYED_NETWORKS=true

# Contract Verification Settings
REACT_APP_CONTRACT_VERIFICATION_RETRIES=3
REACT_APP_CONTRACT_VERIFICATION_TIMEOUT=8000