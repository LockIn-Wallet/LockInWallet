# Which deployment to work against. Reads addresses from
# frontend/src/networkConfig.json and resolves modules from the on-chain
# registry, so no contract addresses belong in here.
NETWORK=base

# The keeper's own wallet. This key pays gas and holds NO role on any contract:
# every call it makes is permissionless, so losing it costs you the gas balance
# and nothing else. Never reuse the deployer key — that one owns upgrades.
KEEPER_PRIVATE_KEY=

# Optional. Falls back to the network's public RPC, which is fine to start with
# and worth replacing with a paid endpoint once deposits matter.
RPC_URL=

# Seconds between passes, in milliseconds. A deposit landing 30s late is
# invisible to someone who has closed the tab; there is no prize for polling
# harder.
INTERVAL_MS=30000

# Stop and shout below this balance rather than firing transactions that fail.
# An out-of-gas keeper is invisible from outside — the app keeps working and
# deposits quietly stop arriving — so this needs monitoring, not just a value.
MIN_BALANCE_ETH=0.0005
